# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Phase 1 default is local preview. Do not put production secrets here.
NUXT_PUBLIC_SITE_URL=http://localhost:5050

# Local listen port. Do not use 5030, 5040, 5000, 5010, 5020, or 52100.
NUXT_PORT=5050

# Analytics vendor is not wired in Phase 1. Leave false.
NUXT_PUBLIC_ANALYTICS_ENABLED=false

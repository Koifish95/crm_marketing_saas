# Copy this whole file to .env, then fill in NUXT_AUTH_PASSWORD.
# Never commit .env.

APP_ENV=dev

# Session cookie seal (must be at least 32 characters).
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-characters

DATABASE_URL=file:./data/app.sqlite

# Required for `pnpm db:setup`. Seed fails if this is missing.
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@local
NUXT_AUTH_PASSWORD=change-me-admin-password

# Local listen port. Preferred URL is http://localhost:5040.
# Never uses 3000, 5000, 5010, 5020 (MA Docker), or 5030 (MA local).
NUXT_PORT=5040
PORT=5040

NUXT_PUBLIC_APP_NAME=Sales CRM
NUXT_PUBLIC_BRAND_NAME=Sales
NUXT_PUBLIC_BRAND_LOCATION=CRM
NUXT_PUBLIC_TIMEZONE=America/Denver

    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",

# Copy this whole file to .env, then fill in the Meta values below.
# Never commit .env.
# Docker environments use .env.dev / .env.stage / .env.production instead
# (see .env.*.example). Local `pnpm dev` keeps using this file.

# Application environment identity: dev | stage | production
# Do not derive this from NODE_ENV. Invalid values fail startup.
APP_ENV=dev

# Session cookie seal (must be at least 32 characters).
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-characters

# Optional. Defaults to true only when APP_ENV=production.
# Local HTTP Docker STAGE/PRODUCTION-definition QA should set false.
# SESSION_COOKIE_SECURE=false

# SQLite via libsql. Keep this on persistent disk in production.
DATABASE_URL=file:./data/app.sqlite

# Required for `pnpm db:setup`. Seed fails if this is missing. This file is local
# lab only — do not treat the example value as a SaaS or production password.
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@local
NUXT_AUTH_PASSWORD=change-me-admin-password

# Set to true once to re-hash NUXT_AUTH_PASSWORD onto the existing admin row.
# NUXT_AUTH_RESET_PASSWORD=true

# Local listen port. Preferred URL is http://localhost:5030.
# `pnpm dev` stops whatever is already on 5030, then binds 5030.
# It never uses 3000, 5000, 5010, or 5020 (Docker PRODUCTION / STAGE / DEV).
# If 5030 still cannot bind, it tries 5031–5035 and then exits.
NUXT_PORT=5030
PORT=5030

# Display name. Defaults are generic martial-arts labels, not Renzo.
NUXT_PUBLIC_APP_NAME=Martial Arts Acquisition
NUXT_PUBLIC_BRAND_NAME=Martial Arts
NUXT_PUBLIC_BRAND_LOCATION=Academy
# Optional public-form tagline. Leave empty to hide it.
# NUXT_PUBLIC_PUBLIC_TAGLINE=

# Display timezone (America/Denver).
NUXT_PUBLIC_TIMEZONE=America/Denver

# Meta Marketing API (read-only V1). The rest of the app works if these stay empty.
# After filling them in, restart `pnpm dev`, sign in as ADMIN, open /settings/meta,
# and click Sync Meta data.
# Token needs ads_read and must be able to reach this ad account.

# Optional override for marketing asset bytes. Default is data/uploads/.
# ASSET_UPLOAD_DIR=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0

# Process controls (ADMIN Settings). Leave restart off unless a supervisor will
# start this process again after it exits. pnpm dev cannot self-restart.
# APP_RESTART_ENABLED=false
# APP_RESTART_EXIT_CODE=0

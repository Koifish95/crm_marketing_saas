# DEV Docker environment. Copy to .env.dev and keep that file out of Git.
# Local URL: http://localhost:5020

APP_ENV=dev
SESSION_COOKIE_SECURE=false

# Session cookie seal (must be at least 32 characters). DEV-only value.
NUXT_SESSION_PASSWORD=change-me-dev-session-password-32ch

# Development bootstrap. Sign in as admin or admin@local / setup.
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@local
NUXT_AUTH_PASSWORD=setup

NUXT_PUBLIC_TIMEZONE=America/Denver

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0

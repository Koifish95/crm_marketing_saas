# Lab customer Acme · DEV. Copy to .env.lab-acme-dev for local overrides.
# Do not use webhosting_renzo_* or renzo-prod-* volume or path names.
# ADMIN password here is a lab placeholder, not a SaaS default.

APP_ENV=dev
NUXT_PUBLIC_APP_ENV=dev

DATABASE_URL=file:./data/lab-acme-dev/sqlite/crm.sqlite
ASSET_UPLOAD_DIR=./data/lab-acme-dev/uploads

NUXT_PORT=52050
PORT=52050

NUXT_SESSION_PASSWORD=change-me-lab-acme-dev-session-32ch
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@lab-acme-dev.local
NUXT_AUTH_PASSWORD=change-me-lab-acme-dev-admin

NUXT_PUBLIC_TIMEZONE=America/Denver
SESSION_COOKIE_SECURE=false

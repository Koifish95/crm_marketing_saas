# PRODUCTION Docker environment. Copy to .env.production and keep that file out of Git.
# Local pre-production URL: http://localhost:5000
#
# Replace every placeholder before a real deployment.
# Do not use DEV bootstrap credentials (admin / setup).
# Catalog seed still runs. Admin bootstrap happens only if NUXT_AUTH_PASSWORD is set.
# Leave NUXT_AUTH_PASSWORD empty to skip known-default admin creation.

APP_ENV=production

# false for local HTTP pre-production QA. Set true behind HTTPS in real production.
SESSION_COOKIE_SECURE=false

# Session cookie seal (must be at least 32 characters). PRODUCTION-only value.
NUXT_SESSION_PASSWORD=change-me-production-session-password-32ch

NUXT_AUTH_USERNAME=admin
# NUXT_AUTH_EMAIL=
# NUXT_AUTH_PASSWORD=

NUXT_PUBLIC_TIMEZONE=America/Denver

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0

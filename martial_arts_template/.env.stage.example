# STAGE Docker environment. Copy to .env.stage and keep that file out of Git.
# Local URL: http://localhost:5010
# Seed creates admin / admin@local / setup when these are unset.

APP_ENV=stage
SESSION_COOKIE_SECURE=false

# Session cookie seal (must be at least 32 characters). STAGE-only value.
NUXT_SESSION_PASSWORD=change-me-stage-session-password-32

NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@local
NUXT_AUTH_PASSWORD=setup

NUXT_PUBLIC_TIMEZONE=America/Denver

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0

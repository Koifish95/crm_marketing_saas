# Lab customer Acme · PROD. Copy to .env.lab-acme-prod for local overrides.
# Do not use webhosting_renzo_* or renzo-prod-* volume or path names.
# ADMIN password here is a lab placeholder, not a SaaS default.

APP_ENV=production
NUXT_PUBLIC_APP_ENV=production

DATABASE_URL=file:./data/lab-acme-prod/sqlite/crm.sqlite
ASSET_UPLOAD_DIR=./data/lab-acme-prod/uploads

NUXT_PORT=5040
PORT=5040

NUXT_SESSION_PASSWORD=change-me-lab-acme-prod-session-32
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@lab-acme-prod.local
NUXT_AUTH_PASSWORD=change-me-lab-acme-prod-admin

NUXT_PUBLIC_TIMEZONE=America/Denver
SESSION_COOKIE_SECURE=false

# Lab customer Acme · PROD. Copy to .env.lab-acme-prod for local overrides.
# Do not use webhosting_renzo_* or renzo-prod-* volume or path names.
# ADMIN password here is a lab/operator convenience, not a SaaS customer default.

APP_ENV=production
NUXT_PUBLIC_APP_ENV=production

# Host Nitro (pnpm lab serve) uses these paths. Docker Compose overrides them to
# file:/app/data/sqlite/crm.sqlite and /app/data/uploads on named lab volumes.
DATABASE_URL=file:./data/lab-acme-prod/sqlite/crm.sqlite
ASSET_UPLOAD_DIR=./data/lab-acme-prod/uploads

NUXT_PORT=52040
PORT=52040

NUXT_SESSION_PASSWORD=change-me-lab-acme-prod-session-32
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@lab-acme-prod.local
NUXT_AUTH_PASSWORD=setup
NUXT_AUTH_RESET_PASSWORD=false

NUXT_PUBLIC_APP_NAME=Acme BJJ Acquisition
NUXT_PUBLIC_BRAND_NAME=Acme BJJ
NUXT_PUBLIC_BRAND_LOCATION=Lab PROD
NUXT_PUBLIC_TIMEZONE=America/Denver
SESSION_COOKIE_SECURE=false

NITRO_HOST=127.0.0.1
NITRO_PORT=52100
HOSTING_NODE_NAME=vps-1
HOSTING_NODE_KIND=vps
EDGE_PROXY_MODE=host-network
REPO_ROOT=/opt/sic/crm_marketing_saas
EDGE_ROOT=/opt/sic/crm_marketing_saas/deploy/edge
SKIP_LAB_SEED=true
# S8: new PROD environments get {customer-slug}.$PUBLIC_BASE_DOMAIN (needs a wildcard A record to this node).
PUBLIC_BASE_DOMAIN=nuxxion.com
# Hostname assignment issues the Let's Encrypt certificate through deploy/edge/issue-cert.sh.
EDGE_AUTO_CERT=true
# Optional. Unset reuses the ACME account already in deploy/edge/letsencrypt.
# ACME_EMAIL=
DATABASE_URL=file:/opt/sic/crm_marketing_saas/control_plane/data/control-plane.sqlite

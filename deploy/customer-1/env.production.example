# Copy to deploy/customer-1/.env.production on the production host.
# Never commit the filled file.

EXPECTED_IMAGE=martial-arts-acquisition:customer1
CONTAINER_NAME=customer1-ma-prod-app
SQLITE_VOLUME=customer1-ma-prod-sqlite
ASSETS_VOLUME=customer1-ma-prod-assets
RELEASE_ID=replace-with-git-sha
NUXT_PUBLIC_ORIGIN=https://REPLACE_WITH_CUSTOMER_HOSTNAME
NUXT_SESSION_PASSWORD=replace-with-32-plus-random-characters
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_EMAIL=admin@customer.example
NUXT_AUTH_PASSWORD=replace-with-unique-initial-password
NUXT_AUTH_MUST_CHANGE_PASSWORD=true
NUXT_PUBLIC_APP_NAME=Customer Academy Acquisition
NUXT_PUBLIC_BRAND_NAME=Customer Academy
NUXT_PUBLIC_BRAND_LOCATION=PROD
NUXT_PUBLIC_TIMEZONE=America/Denver
SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_IPS=127.0.0.1
